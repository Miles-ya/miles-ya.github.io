views:
  - type: table
    name: 视图
    filters:
      and:
        - file.ext == "md"
        - file.folder.contains("周报")
    order:
      - file.name
      - file.path
      - title
      - category
      - tags
      - date
      - created
      - updated
    columnSize:
      file.name: 70
      file.path: 296
      note.title: 204
      note.category: 105
      note.tags: 260
      note.date: 194
      note.updated: 149
